{
    "name": "form-generator-app",
    "version": "0.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/ngx-form-generator.git"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build form-generator",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "build:lib": "ng build form-generator -c production",
        "publish-package": "npm run build:lib && npm publish ./dist/form-generator --access public",
        "publish-package:beta": "npm run build:lib && npm publish ./dist/form-generator --tag beta --access public",
        "publish-package:dry-run": "npm run build:lib && npm publish ./dist/form-generator --dry-run"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.0.0",
        "@angular/common": "^22.0.0",
        "@angular/compiler": "^22.0.0",
        "@angular/core": "^22.0.0",
        "@angular/forms": "^22.0.0",
        "@angular/platform-browser": "^22.0.0",
        "@angular/platform-browser-dynamic": "^22.0.0",
        "@angular/router": "^22.0.0",
        "core-js": "^3.21.1",
        "rxjs": "^7.4.0",
        "tslib": "^2.4.0",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular/build": "^22.0.0",
        "@angular/cli": "^22.0.0",
        "@angular/compiler-cli": "^22.0.0",
        "@angular/language-service": "^22.0.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.1",
        "angular-eslint": "22.0.0",
        "eslint": "^10.3.0",
        "jsdom": "^29.1.1",
        "ng-packagr": "^22.0.0",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "ts-node": "~7.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "8.59.2",
        "vitest": "^4.1.8"
    }
}
