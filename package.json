{
    "name": "form-generator-app",
    "version": "0.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/Recursyve/ngx-form-generator.git"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build form-generator",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "build:lib": "ng build form-generator -c production",
        "publish-package": "npm run build:lib && npm publish ./dist/form-generator --access public",
        "publish-package:beta": "npm run build:lib && npm publish ./dist/form-generator --tag beta --access public",
        "publish-package:dry-run": "npm run build:lib && npm publish ./dist/form-generator --dry-run"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^21.0.5",
        "@angular/common": "^21.0.5",
        "@angular/compiler": "^21.0.5",
        "@angular/core": "^21.0.5",
        "@angular/forms": "^21.0.5",
        "@angular/platform-browser": "^21.0.5",
        "@angular/platform-browser-dynamic": "^21.0.5",
        "@angular/router": "^21.0.5",
        "core-js": "^3.21.1",
        "rxjs": "^7.4.0",
        "tslib": "^2.4.0",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21.0.3",
        "@angular/cli": "^21.0.3",
        "@angular/compiler-cli": "^21.0.5",
        "@angular/language-service": "^21.0.5",
        "@eslint/js": "^10.0.1",
        "@types/jasmine": "~3.6.0",
        "@types/jasminewd2": "~2.0.3",
        "@types/node": "^12.11.1",
        "angular-eslint": "21.4.0",
        "eslint": "^10.3.0",
        "jasmine-core": "~3.6.0",
        "jasmine-spec-reporter": "~5.0.0",
        "karma": "~6.3.20",
        "karma-chrome-launcher": "~3.1.0",
        "karma-coverage-istanbul-reporter": "~3.0.2",
        "karma-jasmine": "~4.0.0",
        "karma-jasmine-html-reporter": "^1.5.0",
        "ng-packagr": "^21.0.1",
        "ts-node": "~7.0.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.59.2"
    }
}
